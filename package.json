{
  "name": "midikey-elite",
  "version": "1.0.0",
  "private": true,
  "description": "WILSONIX MIDIKEY - Ableton-inspired Live Performance Workstation & DAW for Desktop and Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:desktop": "tools\\tauri-dev.bat",
    "build": "vite build",
    "build:desktop": "tools\\tauri-build.bat",
    "build:apk": "vite build && npx cap copy android && cd android && gradlew.bat assembleDebug && cd .. && powershell -Command \"Copy-Item android/app/build/outputs/apk/debug/app-debug.apk dist-apk/wilsonix-midikey.apk -Force\"",
    "build:android": "npm run build:apk",
    "clean": "tools\\clean-cache.bat",
    "clean:drive-x": "powershell -ExecutionPolicy Bypass -NoProfile -File tools\\clean-cache.ps1 -Target drive-x",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "start src-tauri/target/release/wilsonix-midikey.exe",
    "gen-license": "node tools/license-generator.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tauri-apps/cli": "^2.11.4",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "soundfont-player": "^0.12.0"
  }
}
