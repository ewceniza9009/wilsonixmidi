{
  "name": "midikey-elite",
  "version": "2.0.3",
  "private": true,
  "description": "WILSONIX MIDIKEY - Ableton-inspired Live Performance Workstation & DAW for Desktop and Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "lint": "eslint src",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev:desktop": "tools\\tauri-dev.bat",
    "build": "vite build",
    "build:desktop": "node tools/transcode-sample-assets.mjs && node tools/check-sample-assets.mjs && tools\\tauri-build.bat",
    "build:apk": "node tools/transcode-sample-assets.mjs && node tools/check-sample-assets.mjs && vite build && npx cap copy android && cd android && gradlew.bat assembleDebug && cd .. && powershell -Command \"Copy-Item android/app/build/outputs/apk/debug/app-debug.apk dist-apk/wilsonix-midikey.apk -Force\"",
    "build:android": "npm run build:apk",
    "build:prune": "node tools/transcode-sample-assets.mjs && node tools/check-sample-assets.mjs",
    "clean": "tools\\clean-cache.bat",
    "clean:drive-x": "powershell -ExecutionPolicy Bypass -NoProfile -File tools\\clean-cache.ps1 -Target drive-x",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:patch": "node tools/bump-version.js patch",
    "version:minor": "node tools/bump-version.js minor",
    "version:major": "node tools/bump-version.js major",
    "version:sync": "node tools/bump-version.js sync",
    "version:set": "node tools/bump-version.js",
    "build:all": "npm run build && npm run build:android && npm run build:desktop",
    "gen-license": "node tools/license-generator.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "soundfont-player": "^0.12.0"
  }
}
